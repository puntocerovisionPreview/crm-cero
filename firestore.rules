rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo las cuentas de Google autorizadas leen y escriben los datos del CRM.
    // Tiene que coincidir con ALLOWED_EMAILS en src/utils/authAccess.ts y server.ts.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['puntocerovision@gmail.com', 'liendojuan070@gmail.com'];
    }

    // Portal del alumno: cualquiera con el link (token largo y aleatorio) puede leer
    // SU documento, pero nadie puede listar la colección ni escribir.
    match /student_portals/{token} {
      allow get: if true;
    }

    // Portal del cliente PAF: solo lo lee un correo de emailsAutorizados, entrando con
    // su propia cuenta de Google. Saber el ID (PAF-002) no alcanza. Para listar, la
    // consulta tiene que filtrar por su correo (array-contains). Escribe solo el dueño.
    match /paf_portal/{clienteId} {
      allow get, list: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.emailsAutorizados;
    }

    // "Terminé" del estudio: lo único que el cliente puede escribir. Solo crea un aviso
    // con su propio correo y la hora del servidor; no aprueba nada (eso lo hace Juan).
    function isPortalReader(clienteId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/paf_portal/$(clienteId)).data.emailsAutorizados;
    }

    match /paf_portal/{clienteId}/avisos/{avisoId} {
      allow read: if isPortalReader(clienteId);
      allow create: if isPortalReader(clienteId)
        && request.resource.data.keys().hasOnly(['tareaId', 'email', 'creadoEn'])
        && request.resource.data.tareaId is string
        && request.resource.data.tareaId.size() > 0
        && request.resource.data.tareaId.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.creadoEn == request.time;
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
