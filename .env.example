# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Automatizaciones (ver GUIA-AUTOMATIZACION.md). Cargalas en AI Studio > Secrets. ---
# JSON completo de la cuenta de servicio de Firebase (o el mismo JSON en base64)
FIREBASE_SERVICE_ACCOUNT=""
# Token del bot de Telegram creado con @BotFather
TELEGRAM_BOT_TOKEN=""
# Clave larga inventada por vos; el reloj externo la manda en cada llamada
CRON_SECRET=""
# (Opcional) Tu Gmail, para sincronizar Google Calendar
GOOGLE_CALENDAR_ID=""
# (Opcional) Token personal de Calendly (Calendly → Integraciones → API y webhooks).
# Necesita un plan con webhooks (Standard o superior). Las reservas entran solas a la Agenda.
CALENDLY_TOKEN=""
# (Opcional) Chat de Telegram fijo; si no, se usa el que conectás desde Ajustes
TELEGRAM_CHAT_ID=""
