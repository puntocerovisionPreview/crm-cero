# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Google Drive del estudio (ver docs/drive-setup.md) ---
# Cliente OAuth de tipo Aplicación web. Callback: APP_URL/api/drive/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Clave aleatoria de 32 bytes en base64. Guardar estable en Secrets, nunca en Git.
GOOGLE_OAUTH_ENCRYPTION_KEY=""
# Google Picker: clave de API pública restringida al dominio del CRM y a Picker API.
# Se usa solo para seleccionar archivos finales con drive.file.
GOOGLE_PICKER_API_KEY=""

# --- Automatizaciones (ver GUIA-AUTOMATIZACION.md). Cargalas en AI Studio > Secrets. ---
# JSON completo de la cuenta de servicio de Firebase (o el mismo JSON en base64)
FIREBASE_SERVICE_ACCOUNT=""
# Token del bot de Telegram creado con @BotFather
TELEGRAM_BOT_TOKEN=""
# Clave larga inventada por vos; el reloj externo la manda en cada llamada
CRON_SECRET=""
# (Opcional) Tu Gmail, para sincronizar Google Calendar
GOOGLE_CALENDAR_ID=""
# (Opcional) Token personal de Calendly (Calendly → Integraciones → API y webhooks).
# Necesita un plan con webhooks (Standard o superior). Las reservas entran solas a la Agenda.
CALENDLY_TOKEN=""
# (Opcional) Chat de Telegram fijo; si no, se usa el que conectás desde Ajustes
TELEGRAM_CHAT_ID=""
# (Opcional) Access Token de producción de tu aplicación de Mercado Pago (los cobros entran solos)
MP_ACCESS_TOKEN=""
# (Opcional) Clave secreta del webhook de Mercado Pago (valida la firma de cada aviso)
MP_WEBHOOK_SECRET=""
# (Opcional) Claves de notificaciones push. Si no las cargás, el servidor las genera solo.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# (Opcional) Documenso, para que los clientes firmen los presupuestos.
# URL de tu instancia (o https://app.documenso.com), API token y secreto del webhook
DOCUMENSO_URL=""
DOCUMENSO_API_KEY=""
DOCUMENSO_WEBHOOK_SECRET=""
